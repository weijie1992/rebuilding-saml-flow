# Copy to .env to override defaults used by docker-compose.yml.

# Browser-facing URLs. These appear inside signed SAML XML, so they must be
# what your browser types — never Docker-internal names like http://idp:4000.
SP_BASE_URL=http://localhost:3000
IDP_BASE_URL=http://127.0.0.1:4000

# Lab-only visibility: show decoded XML on the IdP POST page and the SP /debug page.
LAB_DEBUG=true

# Accept unsolicited (IdP-initiated) responses with no InResponseTo. Phase 5.
ALLOW_IDP_INITIATED=false
